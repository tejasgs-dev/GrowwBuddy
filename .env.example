# Copy to .env and fill in. Never commit .env.

# Groq API credential. Only needed for live model calls (CLI chat, server, eval).
GROQ_API_KEY=

# Model settings
GROQ_MODEL=openai/gpt-oss-120b
GROWWBUDDY_REASONING_EFFORT=low
GROWWBUDDY_LLM_TIMEOUT_S=30
GROWWBUDDY_LLM_MAX_RETRIES=2
# Longest retry-after (seconds) a chat request waits on a 429; longer gets the busy reply
GROWWBUDDY_LLM_MAX_RETRY_WAIT_S=10

# Groq rate limits for your organisation (check the Groq console; free tier shown)
GROWWBUDDY_GROQ_RPM=30
GROWWBUDDY_GROQ_RPD=1000
GROWWBUDDY_GROQ_TPM=8000
GROWWBUDDY_GROQ_TPD=200000
# Share of each limit the chat app may use (the rest is kept for eval and ingest).
# The budget guard returns the busy reply instead of going over it.
GROWWBUDDY_GROQ_HEADROOM=0.8

# Per-client and per-IP limits on messages that need the model (rule-handled ones don't
# count). Sized to the free tier's ~80 model-answered messages a day in total.
GROWWBUDDY_CLIENT_PER_MINUTE=2
GROWWBUDDY_CLIENT_PER_DAY=20
GROWWBUDDY_IP_PER_MINUTE=4
GROWWBUDDY_IP_PER_DAY=40

# Storage (defaults point to <project>/data/; uncomment to override)
# GROWWBUDDY_DB_URL=sqlite:///data/growwbuddy.db

# Retrieval
# Embedding model; downloaded once (~130 MB) on the first ingest. Changing it re-embeds everything.
GROWWBUDDY_EMBED_MODEL=intfloat/e5-small-v2
GROWWBUDDY_HISTORY_TURNS=6
# Low-confidence cutoff (task 6.3). Left unset: `make eval-cutoff` found no values that
# catch a not-in-corpus question without also cutting answerable ones (Phase 6 results).
# GROWWBUDDY_RETRIEVAL_MIN_SCORE=
# GROWWBUDDY_RETRIEVAL_MIN_GAP=

# Freshness: answers add "(source may be out of date)" when the cited page hasn't been
# fetched, or confirmed unchanged by the daily refresh's heartbeat, in this many days.
# 3 = two missed daily runs (task 7.7).
GROWWBUDDY_STALE_DAYS=3

# Daily index refresh (Phase 7). The GitHub Actions job "Refresh data" publishes index-*
# releases; the server pulls the newest at startup and every GROWWBUDDY_INDEX_POLL_MINUTES.
# Leave GROWWBUDDY_INDEX_REPO unset to use local `make ingest` only.
# GROWWBUDDY_INDEX_REPO=owner/name
GROWWBUDDY_INDEX_POLL_MINUTES=60
# Read-only token (fine-grained, Contents: read), only needed if the repository is private
# GROWWBUDDY_INDEX_TOKEN=

# Threads with no activity for this many days are deleted (0 keeps them)
GROWWBUDDY_THREAD_RETENTION_DAYS=30

# API
GROWWBUDDY_FRONTEND_ORIGIN=http://localhost:5173
# Built web UI served at / (task 5.10). Default: <project>/frontend/dist
# GROWWBUDDY_FRONTEND_DIST=
